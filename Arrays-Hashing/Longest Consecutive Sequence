/*
Longest Consecutive Sequence
Pattern : Arrays & Hashing
*/

/*
Brute Force
Time Complexity : o(n*n*n)
Space Complexity : o(1)
*/

class Solution {
    public int longestConsecutive(int[] nums) {
        
        int max=0;
        for(int i=0;i<nums.length;i++){
            int curr=nums[i];
            int c=0;
            boolean found=true;
            while(found){
                found=false;
            for(int j=0;j<nums.length;j++){
                if(nums[j]==curr){
                    curr++;
                    c++;
                    found=true;
                    break;
                }
            }
            }
            max=Math.max(max,c);
        }
        return max;
    }
}

/*
Optimal
Time Complexity : o(n)
Space Complexity : o(n)
*/

class Solution {
    public int longestConsecutive(int[] nums) {
        Set<Integer> set=new HashSet<>();

        for(Integer i:nums){
            set.add(i);
        }

        int max=0;
        for(Integer j:set){
            if(!set.contains(j-1)){
                int c=1;
                int curr=j+1;
                while(set.contains(curr)){
                    c++;
                    curr++;
                }
                max=Math.max(max,c);
            }
        }
        return max;
    }
}
