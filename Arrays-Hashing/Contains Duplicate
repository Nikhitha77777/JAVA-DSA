/*
Problem: Contains Duplicate
Pattern: Arrays & Hashing
*/

/* 
Brute Force 
T.C : O(n*n) 
S.C : O(1)
*/
class Solution {
    public boolean containsDuplicate(int[] nums) {
       for(int i=0;i<nums.length;i++){
        for(int j=0;j<nums.length;j++){
            if(i==j){
                continue;
            }
            else if(nums[i]==nums[j]){
                return true;
            }
        }
       }
       return false;
    }
}

/* 
Optimal
T.C : O(n)
S.C O(n) 
*/
class Solution {
    public boolean containsDuplicate(int[] nums) {
       Set<Integer> st=new HashSet<>();
       for(Integer i:nums){
        if(st.contains(i)){
            return true;
        }
        st.add(i);
       }
       return false;
    }
}
